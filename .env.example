# ─────────────────────────────────────────────────────────────
# Dsectors CMS — environment variables
# Copy to .env.local for local `vercel dev`, and set the same keys
# in the Vercel dashboard (Project → Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# ── Admin login ──
# The password you type on the /admin login screen.
ADMIN_PASSWORD=change-this-to-a-strong-password
# Random long string used to sign the admin session cookie.
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-hex-string

# ── Upstash Redis (content + leads storage) ──
# From the Upstash integration (Vercel → Storage → add Upstash Redis)
# it usually injects KV_REST_API_URL / KV_REST_API_TOKEN automatically.
# If you created Upstash directly, use the UPSTASH_* pair instead.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (fallback names, only needed if the KV_* pair is not set)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Vercel Blob (image uploads) ──
# Auto-injected when you add a Blob store (Vercel → Storage → Blob).
BLOB_READ_WRITE_TOKEN=

# ── Resend (lead notification email) ──
RESEND_API_KEY=
# Verified sender (or onboarding@resend.dev while testing).
LEAD_FROM_EMAIL=onboarding@resend.dev
# Where new-lead notifications are sent.
LEAD_NOTIFY_EMAIL=info@dsectors.org
